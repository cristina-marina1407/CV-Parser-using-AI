# Azure OpenAI Configuration
# Add your Azure OpenAI details here

# Your Azure OpenAI API key
AZURE_OPENAI_KEY=your_azure_openai_key_here

# Your Azure OpenAI endpoint (e.g., https://your-resource.openai.azure.com/)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Your deployment name (the name you gave to your GPT model deployment)
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# API version (keep this unless you need a different version)
AZURE_OPENAI_API_VERSION=2023-12-01-preview
